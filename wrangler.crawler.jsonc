{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artist-analytics-crawler",
  "main": "crawler/src/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  // JavaScript Worker. Do not set python_workers here: that flag makes Wrangler
  // load the Pyodide runtime, which is what a CPU kill leaves permanently broken.
  // Workers Free rejects limits.cpu_ms (build error 100328). Do not add it.
  // Workers Builds overrides the script name from the trigger. This file is the
  // config for trigger 72c7852f (artist-analytics-crawler), not the dashboard.
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artist-analytics",
      "database_id": "52a9190e-4147-402e-8f75-16f5de58bf84",
      "migrations_dir": "src/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CRAWL_QUEUE",
        "queue": "artist-analytics-crawl"
      }
    ],
    "consumers": [
      {
        "queue": "artist-analytics-crawl",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 180,
        "dead_letter_queue": "artist-analytics-crawl-dlq"
      }
    ]
  }
}
