{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artist-analytics",
  "main": "src/main.py",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["python_workers"],
  "preview_urls": false,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // D1 and the crawl queue already exist in the account. Workers Builds
  // attaches these bindings on deploy. It does not apply migrations.
  // 0001_crawl.sql is already applied remotely; do not rename or edit it.
  // The Worker records its own schema_migrations rows and skips applied files.
  // A missing binding is handled in code: history stays empty and the cron
  // logs that it skipped instead of inventing snapshots.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artist-analytics",
      "database_id": "52a9190e-4147-402e-8f75-16f5de58bf84",
      "migrations_dir": "src/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CRAWL_QUEUE",
        "queue": "artist-analytics-crawl"
      }
    ],
    "consumers": [
      {
        "queue": "artist-analytics-crawl",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        // Wait a minute before a retry so a CPU kill does not immediately reuse the isolate.
        "retry_delay": 60,
        // Created on deploy if it does not already exist. Messages that exhaust
        // max_retries land here instead of being deleted. Not consumed by this Worker.
        "dead_letter_queue": "artist-analytics-crawl-dlq"
      }
    ]
  },
  // CSS is not in Wrangler's default Python module rules. fallthrough keeps
  // the default Text rule that uploads src/templates/**/*.html.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css"],
      "fallthrough": true
    }
  ]
  // Secrets are set with `npx wrangler secret put`, not in this file:
  //   SECRET_KEY
  //   YOUTUBE_API_KEY
  // Optional, off unless both are set (not required; Spotify Premium gates Web API apps):
  //   SPOTIFY_CLIENT_ID
  //   SPOTIFY_CLIENT_SECRET
  // Optional response cache. Create it, then uncomment and paste the id.
  // The app uses an in-memory cache until CACHE is bound, so deploy works
  // before this exists.
  //   npx wrangler kv namespace create CACHE
  // "kv_namespaces": [
  //   {
  //     "binding": "CACHE",
  //     "id": "REPLACE_WITH_KV_NAMESPACE_ID"
  //   }
  // ]
}
