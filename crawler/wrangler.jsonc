{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "artist-analytics-crawler",
  "main": "../src/crawler_main.py",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["python_workers"],
  "preview_urls": false,
  // Workers Free rejects limits.cpu_ms (build error 100328). Do not add it here.
  // After upgrading to Workers Paid, the dashboard config's comment shows the block.
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Same D1 database as the dashboard. The Worker applies new files in src/migrations
  // itself. Do not edit 0001_crawl.sql.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artist-analytics",
      "database_id": "52a9190e-4147-402e-8f75-16f5de58bf84",
      "migrations_dir": "../src/migrations"
    }
  ],
  // This Worker is the only consumer of artist-analytics-crawl. The dashboard
  // Worker is a producer only. A queue accepts one consumer, so deploy the
  // dashboard (which drops the old consumer) before this config.
  "queues": {
    "producers": [
      {
        "binding": "CRAWL_QUEUE",
        "queue": "artist-analytics-crawl"
      }
    ],
    "consumers": [
      {
        "queue": "artist-analytics-crawl",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 180,
        "dead_letter_queue": "artist-analytics-crawl-dlq"
      }
    ]
  },
  // Migrations are read from disk at startup. Upload the SQL next to the entrypoint.
  "rules": [
    {
      "type": "Text",
      "globs": ["../src/migrations/*.sql"],
      "fallthrough": true
    }
  ]
  // Secrets are per Worker. Set them on artist-analytics-crawler, not only on
  // the dashboard. YOUTUBE_API_KEY is required for the YouTube provider message:
  //   npx wrangler secret put YOUTUBE_API_KEY -c crawler/wrangler.jsonc
  // If the dashboard has them, also set:
  //   SPOTIFY_CLIENT_ID
  //   SPOTIFY_CLIENT_SECRET
  // SECRET_KEY is only used by the dashboard session cookie.
}
